{
  "name": "dexpi-viewer",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "generate:notices": "node scripts/generateNotices.mjs && biome check --write src/lib/generated/thirdPartyNotices.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tabler/icons-react": "3.45.0",
    "@tredespace/ui": "file:external/tredespace-ui-0.0.56.tgz",
    "canvaskit-wasm": "0.40.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
